#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        iPad_default_layer {
            bindings = <
&kp Q           &kp W             &kp E         &kp R                    &kp T                                             &kp Y        &kp U  &kp I      &lt 5 O  &kp P
&kp A           &kp S             &kp D         &kp F                    &kp G        &kp LS(LG(S))         &lt 6 ESCAPE   &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z           &kp X             &kp C         &kp V                    &kp B        &to 3                 &trans         &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_WIN LANGUAGE_2  &lt 1 SPACE  &lt 5 LANGUAGE_1      &kp BACKSPACE  &lt 2 ENTER                             &kp TAB
            >;

            sensor-bindings = <&inc_dec_kp S D>;
        };

        FUNCTION_ALLOW_MOUSE_iPad {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4  &kp F5                                 &trans             &mkp MB4  &mkp MB3  &mkp MB5   &trans
&kp F6   &kp F7   &kp F8   &kp F9  &kp LEFT_BRACKET  &trans      &trans   &kp RIGHT_BRACKET  &mkp MB1  &kp UP    &mkp MB2   &kp LS(NUMBER_1)
&kp F10  &kp F11  &kp F12  &trans  &kp LCTRL         &trans      &trans   &kp LS(MINUS)      &kp LEFT  &kp DOWN  &kp RIGHT  &kp QUESTION
&trans   &trans   &trans   &trans  &trans            &trans      &kp DEL  &trans                                            &trans
            >;
        };

        NUM_SYMBOL_iPad {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(N8)                                                  &kp LS(N9)         &kp EXCLAMATION          &kp LS(N7)  &kp AT_SIGN  &kp LS(NUMBER_4)
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RIGHT_BRACKET      &kp LC(LA(KP_NUMBER_0))      &trans  &kp BACKSLASH      &kp MINUS                &kp TILDE   &kp HASH     &kp SINGLE_QUOTE
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LS(RIGHT_BRACKET)  &kp EQUAL                    &trans  &kp LS(BACKSLASH)  &kp LS(INTERNATIONAL_1)  &kp EQUAL   &kp LBKT     &kp LS(SLASH)
&trans                      &kp N0           &kp PERIOD       &trans           &trans                 &trans                       &trans  &trans                                                               &kp PIPE
            >;
        };

        Windows_Base {
            bindings = <
&kp Q           &kp W         &kp E         &kp R                 &kp T                                             &kp Y        &kp U  &kp I      &lt 5 O  &kp P
&kp A           &kp S         &kp D         &kp F                 &kp G        &kp LS(LG(S))         &lt 6 ESCAPE   &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z           &kp X         &kp C         &kp V                 &kp B        &to 0                 &trans         &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_WIN  &kp LEFT_ALT  &mt LCTRL LANGUAGE_2  &lt 8 SPACE  &lt 5 LANGUAGE_1      &kp BACKSPACE  &lt 9 ENTER                             &kp TAB
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB4  &trans    &mo 5     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB5  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        FUNCTION_ALLOW_MOUSE_windows {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4  &kp F5                                      &trans       &mkp MB4  &mkp MB3  &mkp MB5   &trans
&kp F6   &kp F7   &kp F8   &kp F9  &trans     &trans            &kp PAGE_UP    &kp TAB      &mkp MB1  &kp UP    &mkp MB2   &kp LS(NUMBER_1)
&kp F10  &kp F11  &kp F12  &trans  &kp LCTRL  &kp LEFT_ALT      &kp PAGE_DOWN  &kp LS(TAB)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp QUESTION
&trans   &trans   &trans   &trans  &trans     &trans            &kp DEL        &trans                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        NUM_SYMBOL_windows {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(N8)                                                  &kp LS(N9)         &kp EXCLAMATION          &kp LS(N7)     &kp AT_SIGN  &kp LS(NUMBER_4)
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RIGHT_BRACKET      &kp LC(LA(KP_NUMBER_0))      &trans  &kp BACKSLASH      &kp MINUS                &kp LS(MINUS)  &kp HASH     &kp SINGLE_QUOTE
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LS(RIGHT_BRACKET)  &kp EQUAL                    &trans  &kp LS(BACKSLASH)  &kp LS(INTERNATIONAL_1)  &kp EQUAL      &kp LBKT     &kp LS(SLASH)
&trans                      &kp N0           &kp PERIOD       &trans           &trans                 &trans                       &trans  &trans                                                                  &kp PIPE
            >;
        };
    };
};
